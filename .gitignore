# .gitignore
__pycache__/    # Python's temp bytecode cache folders
*.pyc           # Compiled Python files (not source)
*.pyo           # Optimized .pyc (rare, but auto-generated)
*.save          # Ignore future save files (if you add game state persistence)
.DS_Store       # macOS file metadata (clutters up repos)
/testing/       # Assorted test scripts including merging leaderboard
/testing/**     # All contents inside recursively

assets/leaderboard/*.json
!assets/leaderboard/leaderboard.json # ...EXCEPT this one


